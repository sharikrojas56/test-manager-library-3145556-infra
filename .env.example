# Manager Library - Environment Variables Example
# Copy this file to .env and adjust values for your environment

# PostgreSQL Database Configuration
POSTGRES_PASSWORD=secretpassword
POSTGRES_USER=manager_library
POSTGRES_DB=manager_library
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# pgAdmin Configuration (optional)
PGADMIN_PASSWORD=admin

# Application Database Connection (used by API)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=manager_library
DB_USERNAME=manager_library
DB_PASSWORD=secretpassword

# JWT Secret Key (generate with: php artisan jwt:secret)
JWT_SECRET=your_jwt_secret_key_here_change_this

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# File Storage
FILESYSTEM_DISK=local
COVERS_DISK=local
COVERS_PATH=storage/app/covers
MAX_COVER_SIZE=2048  # 2MB in KB

# Initial Admin User (created at first startup)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123  # Change in production!